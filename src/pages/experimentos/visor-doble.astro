---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { paginaSrc } from "../../types";
import { guiaSlug, paginaBase, zonas } from "../../data/experimentos/visor-doble";

const base = import.meta.env.BASE_URL;
const imgSrc = paginaSrc(base, guiaSlug, paginaBase);

// Solo lo que el visor necesita en el navegador -- direccionEscena (la nota
// morada del proof of concept) es documentacion para quien programa, nunca
// se envia al cliente ni se muestra a quien usa el producto.
const clientZones = zonas.map((z) => ({
  id: z.id,
  box: z.box,
  type: z.type,
  contenido: z.contenido,
  swapTargetPage: z.swapTargetPage ?? null,
  textoParaLeer: z.textoParaLeer ?? null,
}));

const configJson = JSON.stringify({ base, guiaSlug, imgSrc, zonas: clientZones }).replace(/<\//g, "<\\/");
---

<BaseLayout title="Experimento — Visor doble">
  <main class="wrap">
    <p class="eyebrow">Rama experimento/visor-doble · prototipo alterno</p>
    <h1>Visor doble: PDF + zonas interactivas</h1>
    <p class="lede">
      La página del PDF queda tal cual — <strong>Zona 1</strong> — con puntos que invitan a tocar. Al elegir uno, la
      página se hace a un lado y aparece la <strong>Zona 2</strong>, ampliada, con el comentario, la animación o el
      elemento que corresponda. <a href="/guias-pc-wraparound/">← Volver al explorador principal</a>
    </p>

    <div class="stage" id="stage">
      <div class="pane-a" id="pane-a">
        <img src={imgSrc} alt="Página 9 de la guía (Sesión 1)" id="visor-img" />
        {zonas.map((z) => (
          <button
            type="button"
            class="hotspot"
            id={`hotspot-${z.id}`}
            data-zone-id={z.id}
            style={`left:${z.box.x}%; top:${z.box.y}%; width:${z.box.w}%; height:${z.box.h}%;`}
            aria-label="Zona interactiva"
          ></button>
        ))}
      </div>

      <div class="pane-b" id="pane-b">
        <button type="button" class="pane-b-close" id="pane-b-close" aria-label="Cerrar">✕</button>
        <div class="pane-b-body" id="pane-b-body"></div>
      </div>
    </div>

    <button type="button" id="reset-all" class="reset-all">⟲ Reiniciar demo</button>
  </main>
</BaseLayout>

<script type="application/json" id="zones-data" set:html={configJson} />

<script>
  interface Zone {
    id: string;
    box: { x: number; y: number; w: number; h: number };
    type: "reveal" | "animate-bar" | "swap-page" | "read-aloud";
    contenido: string;
    swapTargetPage: number | null;
    textoParaLeer: string | null;
  }
  interface Config {
    base: string;
    guiaSlug: string;
    imgSrc: string;
    zonas: Zone[];
  }

  const dataEl = document.getElementById("zones-data")!;
  const config: Config = JSON.parse(dataEl.textContent || "{}");

  function paginaSrcClient(n: number) {
    const p = String(n).padStart(2, "0");
    return `${config.base}guias/${config.guiaSlug}/paginas/p${p}.webp`;
  }

  const stage = document.getElementById("stage")!;
  const paneBBody = document.getElementById("pane-b-body")!;
  const paneBClose = document.getElementById("pane-b-close")!;
  const visorImg = document.getElementById("visor-img") as HTMLImageElement;

  function zoneById(id: string) {
    return config.zonas.find((z) => z.id === id) || null;
  }

  // --- voz: preferir espanol latinoamericano, idealmente femenino ---
  function getVoicesAsync(): Promise<SpeechSynthesisVoice[]> {
    return new Promise((resolve) => {
      if (!("speechSynthesis" in window)) return resolve([]);
      const existing = window.speechSynthesis.getVoices();
      if (existing.length) return resolve(existing);
      window.speechSynthesis.onvoiceschanged = () => resolve(window.speechSynthesis.getVoices());
      setTimeout(() => resolve(window.speechSynthesis.getVoices()), 1200);
    });
  }

  function pickSpanishVoice(voices: SpeechSynthesisVoice[]): SpeechSynthesisVoice | null {
    const esVoices = voices.filter((v) => v.lang?.toLowerCase().startsWith("es"));
    const latamLangs = ["es-419", "es-us", "es-mx", "es-co", "es-ar", "es-cl", "es-pe", "es-ve", "es-ec", "es-do", "es-gt", "es-pa", "es-uy", "es-py", "es-bo", "es-cr", "es-sv", "es-hn", "es-ni", "es-pr"];
    const femaleHints = ["female", "mujer", "paulina", "lucia", "lucía", "lupe", "monica", "mónica", "sabina", "helena", "camila", "valentina", "esperanza", "estados unidos", "us english"];
    let best: SpeechSynthesisVoice | null = null;
    let bestScore = -Infinity;
    for (const v of esVoices) {
      const lang = v.lang.toLowerCase();
      const name = v.name.toLowerCase();
      let score = 0;
      if (lang === "es-419") score += 12;
      if (latamLangs.includes(lang)) score += 10;
      if (lang === "es-es") score -= 6;
      if (femaleHints.some((h) => name.includes(h))) score += 6;
      if (score > bestScore) {
        bestScore = score;
        best = v;
      }
    }
    return best || esVoices[0] || null;
  }

  let barInterval: ReturnType<typeof setInterval> | undefined;

  async function speak(text: string) {
    if (!("speechSynthesis" in window)) return;
    window.speechSynthesis.cancel();
    const voices = await getVoicesAsync();
    const voice = pickSpanishVoice(voices);
    const utter = new SpeechSynthesisUtterance(text);
    if (voice) {
      utter.voice = voice;
      utter.lang = voice.lang;
    } else {
      utter.lang = "es-419";
    }
    utter.rate = 0.98;
    utter.pitch = 1.03;
    window.speechSynthesis.speak(utter);
  }

  function escapeHtml(s: string) {
    const div = document.createElement("div");
    div.textContent = s;
    return div.innerHTML;
  }

  function renderPane(zone: Zone) {
    clearInterval(barInterval);
    window.speechSynthesis?.cancel();

    if (zone.type === "reveal") {
      paneBBody.innerHTML = `<p class="pb-text">${escapeHtml(zone.contenido)}</p>`;
    }

    if (zone.type === "animate-bar") {
      paneBBody.innerHTML = `
        <div class="pb-bar-wrap">
          <div class="pb-bar-track"><div class="pb-bar-fill" id="pb-bar-fill"></div></div>
          <p class="pb-bar-pct" id="pb-bar-pct">0%</p>
        </div>
        <p class="pb-text">${escapeHtml(zone.contenido)}</p>
      `;
      const fill = document.getElementById("pb-bar-fill")!;
      const pctEl = document.getElementById("pb-bar-pct")!;
      requestAnimationFrame(() => {
        fill.style.width = "15%";
      });
      let n = 0;
      barInterval = setInterval(() => {
        n = Math.min(15, n + 1);
        pctEl.textContent = `${n}%`;
        if (n >= 15) clearInterval(barInterval);
      }, 55);
    }

    if (zone.type === "read-aloud") {
      paneBBody.innerHTML = `
        <div class="pb-dice spin" id="pb-dice">🎲</div>
        <blockquote class="pb-quote">${escapeHtml(zone.textoParaLeer || "")}</blockquote>
        <button type="button" class="pb-replay" id="pb-replay">🔊 Reproducir de nuevo</button>
        <p class="pb-text">${escapeHtml(zone.contenido)}</p>
      `;
      if (zone.textoParaLeer) speak(zone.textoParaLeer);
      document.getElementById("pb-replay")!.addEventListener("click", () => {
        const dice = document.getElementById("pb-dice")!;
        dice.classList.remove("spin");
        requestAnimationFrame(() => dice.classList.add("spin"));
        if (zone.textoParaLeer) speak(zone.textoParaLeer);
      });
    }

    if (zone.type === "swap-page") {
      const src = zone.swapTargetPage ? paginaSrcClient(zone.swapTargetPage) : "";
      paneBBody.innerHTML = `
        <img class="pb-page" src="${src}" alt="Página del anexo referenciado" />
        <p class="pb-text">${escapeHtml(zone.contenido)}</p>
      `;
    }
  }

  function openZone(zoneId: string) {
    const zone = zoneById(zoneId);
    if (!zone) return;
    stage.classList.add("split");
    document.querySelectorAll(".hotspot").forEach((el) => el.classList.remove("current"));
    document.getElementById(`hotspot-${zoneId}`)?.classList.add("current");
    renderPane(zone);
  }

  function closeZone() {
    stage.classList.remove("split");
    document.querySelectorAll(".hotspot").forEach((el) => el.classList.remove("current"));
    clearInterval(barInterval);
    window.speechSynthesis?.cancel();
    setTimeout(() => {
      if (!stage.classList.contains("split")) paneBBody.innerHTML = "";
    }, 400);
  }

  document.querySelectorAll<HTMLButtonElement>(".hotspot").forEach((hs) => {
    hs.addEventListener("click", () => openZone(hs.dataset.zoneId!));
  });

  paneBClose.addEventListener("click", closeZone);

  document.getElementById("reset-all")!.addEventListener("click", () => {
    closeZone();
    visorImg.src = config.imgSrc;
  });

  // --- animacion de entrada: senala las zonas una vez, al cargar ---
  function playIntro() {
    const hotspots = Array.from(document.querySelectorAll<HTMLElement>(".hotspot"));
    hotspots.forEach((hs, i) => {
      setTimeout(() => {
        hs.classList.add("showcase");
        setTimeout(() => hs.classList.remove("showcase"), 750);
      }, i * 260);
    });
  }
  window.addEventListener("load", () => setTimeout(playIntro, 450));
</script>

<style is:global>
  /*
    Global a proposito: la Zona 2 (.pb-*) se arma con innerHTML desde el
    script del cliente, y el CSS "scoped" de Astro solo llega al HTML que
    el propio componente renderiza en el build -- nunca a nodos creados en
    tiempo de ejecucion. Los nombres de clase son especificos de esta
    pagina, asi que el riesgo de choque es bajo.
  */
  .lede {
    max-width: 72ch;
    color: var(--ink-soft);
  }

  .stage {
    display: flex;
    gap: 22px;
    align-items: flex-start;
  }
  @media (max-width: 800px) {
    .stage {
      flex-direction: column;
    }
  }

  .pane-a {
    position: relative;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 12px 28px -18px rgba(0, 0, 0, 0.4);
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    flex: none;
  }
  .stage.split .pane-a {
    width: 32%;
  }
  @media (max-width: 800px) {
    .pane-a,
    .stage.split .pane-a {
      width: 100%;
    }
    .stage.split .pane-a {
      max-height: 260px;
      overflow-y: auto;
    }
  }
  .pane-a img {
    display: block;
    width: 100%;
    height: auto;
  }

  .pane-b {
    width: 0;
    opacity: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper-raised);
    position: relative;
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.35s ease;
    flex: none;
  }
  .stage.split .pane-b {
    width: 62%;
    opacity: 1;
    padding: 30px;
  }
  @media (max-width: 800px) {
    .pane-b,
    .stage.split .pane-b {
      width: 100%;
    }
    .stage.split .pane-b {
      padding: 22px 18px;
      margin-top: 4px;
    }
  }

  .pane-b-close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }
  .pane-b-body {
    max-width: 60ch;
  }
  .pb-text {
    font-size: 16px;
    color: var(--ink);
    margin: 0;
  }
  .pb-quote {
    margin: 16px 0;
    padding: 14px 18px;
    border-left: 3px solid var(--guide-pink);
    background: var(--guide-pink-soft);
    font-style: italic;
    font-size: 16px;
  }
  .pb-dice {
    font-size: 48px;
    display: inline-block;
    margin-bottom: 6px;
  }
  .pb-dice.spin {
    animation: dice-spin 0.9s ease-out;
  }
  @keyframes dice-spin {
    0% {
      transform: rotate(0deg) scale(1);
    }
    60% {
      transform: rotate(300deg) scale(1.15);
    }
    100% {
      transform: rotate(360deg) scale(1);
    }
  }
  .pb-replay {
    display: block;
    margin-bottom: 16px;
    font-family: "JetBrains Mono", monospace;
    font-size: 12.5px;
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--guide-purple);
    background: var(--guide-purple-soft);
    color: var(--guide-purple);
    cursor: pointer;
  }
  .pb-bar-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .pb-bar-track {
    flex: 1;
    height: 22px;
    border-radius: 999px;
    border: 1.5px solid var(--guide-purple);
    background: var(--guide-purple-soft);
    overflow: hidden;
  }
  .pb-bar-fill {
    height: 100%;
    width: 0%;
    background-image: repeating-linear-gradient(45deg, var(--guide-purple) 0 6px, var(--guide-pink) 6px 12px);
    transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pb-bar-pct {
    font-family: "JetBrains Mono", monospace;
    font-weight: 700;
    font-size: 18px;
    color: var(--guide-purple);
    min-width: 3ch;
  }
  .pb-page {
    display: block;
    width: 100%;
    max-width: 340px;
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-bottom: 14px;
  }

  .hotspot {
    position: absolute;
    border: 1.5px dashed var(--guide-purple);
    background: rgba(147, 92, 177, 0.1);
    border-radius: 6px;
    cursor: pointer;
    padding: 0;
    animation: hotspot-idle 3.2s ease-in-out infinite;
  }
  .hotspot:hover {
    background: rgba(147, 92, 177, 0.22);
  }
  .hotspot.current {
    border-style: solid;
    background: rgba(147, 92, 177, 0.3);
    animation: none;
  }
  .stage.split .hotspot:not(.current) {
    opacity: 0.3;
  }
  @keyframes hotspot-idle {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(147, 92, 177, 0);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(147, 92, 177, 0.16);
    }
  }
  .hotspot.showcase {
    animation: hotspot-showcase 0.75s ease-out;
  }
  @keyframes hotspot-showcase {
    0% {
      box-shadow: 0 0 0 0 rgba(147, 92, 177, 0.55);
      background: rgba(147, 92, 177, 0.4);
    }
    100% {
      box-shadow: 0 0 0 20px rgba(147, 92, 177, 0);
      background: rgba(147, 92, 177, 0.1);
    }
  }

  .reset-all {
    display: block;
    margin: 28px auto 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
  }
</style>
