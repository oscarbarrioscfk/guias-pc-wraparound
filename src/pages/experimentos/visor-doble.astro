---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { paginaSrc } from "../../types";
import { guiaSlug, paginaBase, zonas, type HotspotZone } from "../../data/experimentos/visor-doble";

const base = import.meta.env.BASE_URL;
const imgSrc = paginaSrc(base, guiaSlug, paginaBase);

const byPanel = (panel: HotspotZone["panel"]) => zonas.filter((z) => z.panel === panel).sort((a, b) => a.orden - b.orden);
const topZones = byPanel("top");
const leftZones = byPanel("left");
const rightZones = byPanel("right");

const TYPE_LABEL: Record<HotspotZone["type"], string> = {
  reveal: "muestra un comentario",
  "animate-bar": "anima + comentario",
  "swap-page": "cambia de página",
  "read-aloud": "lee en voz alta",
};
---

<BaseLayout title="Experimento — Visor doble">
  <main class="wrap">
    <p class="eyebrow">Rama experimento/visor-doble · prototipo alterno</p>
    <h1>Visor doble: PDF + zonas interactivas</h1>
    <p class="lede">
      Otra forma de construir el wraparound: en vez de re-tipografiar la sesión como bloques de datos, la página del
      PDF queda tal cual — <strong>Visor 1</strong>, al centro — y se le superponen zonas que activan el
      <strong>Visor 2</strong>, el marco alrededor con los comentarios pedagógicos. Basado en el proof of concept que
      trajiste. <a href="/guias-pc-wraparound/">← Volver al explorador principal</a>
    </p>

    <div class="legend">
      {Object.entries(TYPE_LABEL).map(([type, label]) => (
        <span class={`legend-item type-${type}`}>{label}</span>
      ))}
    </div>

    <div class="stage" id="stage">
      <div class="top-row" id="top-row">
        {topZones.map((z) => (
          <div class="panel panel-top" data-panel-for={z.id}>
            <p class="panel-direction">{z.direccionEscena}</p>
            <p class="panel-content">{z.contenido}</p>
          </div>
        ))}
      </div>

      <div class="left-col" id="left-col">
        {leftZones.map((z) => (
          <div class="panel panel-side" data-panel-for={z.id}>
            <p class="panel-direction">{z.direccionEscena}</p>
            <p class="panel-content">{z.contenido}</p>
          </div>
        ))}
      </div>

      <div class="center-col">
        <div class="visor1" id="visor1">
          <img src={imgSrc} alt="Página 9 de la guía (Sesión 1)" id="visor1-img" />
          {zonas.map((z) => (
            <button
              type="button"
              class={`hotspot type-${z.type}`}
              id={`hotspot-${z.id}`}
              data-zone-id={z.id}
              data-type={z.type}
              style={`left:${z.box.x}%; top:${z.box.y}%; width:${z.box.w}%; height:${z.box.h}%;`}
              aria-label={z.direccionEscena}
            ></button>
          ))}
          <button type="button" id="restore-page" class="restore-page" hidden>← volver a la página 9</button>
        </div>
        <p class="visor1-label">Visor 1 — página del PDF (toca las zonas resaltadas)</p>
      </div>

      <div class="right-col" id="right-col">
        {rightZones.map((z) => (
          <div class="panel panel-side" data-panel-for={z.id}>
            <p class="panel-direction">{z.direccionEscena}</p>
            <p class="panel-content">{z.contenido}</p>
          </div>
        ))}
      </div>
    </div>

    <button type="button" id="reset-all" class="reset-all">⟲ Reiniciar demo</button>
  </main>
</BaseLayout>

<script define:vars={{ imgSrc, base, guiaSlug, swapTargets: Object.fromEntries(zonas.filter((z) => z.swapTargetPage).map((z) => [z.id, z.swapTargetPage])), readAloud: Object.fromEntries(zonas.filter((z) => z.textoParaLeer).map((z) => [z.id, z.textoParaLeer])) }}>
  function paginaSrcClient(n) {
    const p = String(n).padStart(2, "0");
    return `${base}guias/${guiaSlug}/paginas/p${p}.webp`;
  }

  const visor1 = document.getElementById("visor1");
  const visor1Img = document.getElementById("visor1-img");
  const restoreBtn = document.getElementById("restore-page");
  const originalSrc = imgSrc;

  function panelFor(zoneId) {
    return document.querySelector(`[data-panel-for="${zoneId}"]`);
  }

  function alignPanels() {
    document.querySelectorAll(".hotspot").forEach((hs) => {
      const zoneId = hs.dataset.zoneId;
      const panel = panelFor(zoneId);
      if (!panel || panel.closest(".top-row")) return;
      const col = panel.parentElement;
      const colRect = col.getBoundingClientRect();
      const hsRect = hs.getBoundingClientRect();
      const centerY = hsRect.top - colRect.top + hsRect.height / 2;
      const panelHeight = panel.getBoundingClientRect().height;
      const top = centerY - panelHeight / 2;
      panel.style.top = `${Math.max(0, top)}px`;
    });
  }

  function activate(zoneId) {
    const panel = panelFor(zoneId);
    if (panel) panel.classList.add("active");
  }

  function pulseBadge(hotspot, text) {
    const badge = document.createElement("span");
    badge.className = "pulse-badge";
    badge.textContent = text;
    hotspot.appendChild(badge);
    hotspot.classList.add("pulsing");
    setTimeout(() => {
      hotspot.classList.remove("pulsing");
      badge.remove();
    }, 1600);
  }

  function speak(text) {
    if (!("speechSynthesis" in window)) return;
    window.speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(text);
    utter.lang = "es-CO";
    utter.rate = 0.98;
    window.speechSynthesis.speak(utter);
  }

  document.querySelectorAll(".hotspot").forEach((hotspot) => {
    hotspot.addEventListener("click", () => {
      const zoneId = hotspot.dataset.zoneId;
      const type = hotspot.dataset.type;
      activate(zoneId);

      if (type === "animate-bar") {
        pulseBadge(hotspot, "15%");
      }

      if (type === "read-aloud") {
        pulseBadge(hotspot, "🎲");
        const text = readAloud[zoneId];
        if (text) speak(text);
      }

      if (type === "swap-page") {
        const target = swapTargets[zoneId];
        if (target) {
          visor1Img.src = paginaSrcClient(target);
          visor1Img.alt = "Página del anexo referenciado";
          restoreBtn.hidden = false;
          visor1.classList.add("swapped");
        }
      }
    });
  });

  restoreBtn.addEventListener("click", () => {
    visor1Img.src = originalSrc;
    visor1Img.alt = "Página 9 de la guía (Sesión 1)";
    restoreBtn.hidden = true;
    visor1.classList.remove("swapped");
  });

  document.getElementById("reset-all").addEventListener("click", () => {
    document.querySelectorAll(".panel.active").forEach((p) => p.classList.remove("active"));
    visor1Img.src = originalSrc;
    restoreBtn.hidden = true;
    visor1.classList.remove("swapped");
    window.speechSynthesis?.cancel();
  });

  window.addEventListener("load", alignPanels);
  window.addEventListener("resize", alignPanels);
  document.fonts?.ready.then(alignPanels).catch(() => {});
  setTimeout(alignPanels, 50);
</script>

<style>
  .lede {
    max-width: 72ch;
    color: var(--ink-soft);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin: 18px 0 28px;
  }
  .legend-item {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .stage {
    display: grid;
    grid-template-columns: 240px minmax(0, 460px) 240px;
    grid-template-rows: auto 1fr;
    column-gap: 22px;
    row-gap: 12px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .stage {
      grid-template-columns: 1fr;
    }
  }

  .top-row {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    justify-content: center;
  }
  @media (max-width: 900px) {
    .top-row {
      grid-column: 1;
    }
  }

  .left-col,
  .right-col {
    grid-row: 2;
    position: relative;
    min-height: 100%;
  }
  .left-col {
    grid-column: 1;
  }
  .right-col {
    grid-column: 3;
  }
  @media (max-width: 900px) {
    .left-col,
    .right-col {
      grid-column: 1;
      position: static;
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 16px;
    }
  }

  .center-col {
    grid-column: 2;
    grid-row: 2;
  }
  @media (max-width: 900px) {
    .center-col {
      grid-column: 1;
    }
  }

  .visor1 {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 12px 28px -18px rgba(0, 0, 0, 0.4);
  }
  .visor1 img {
    display: block;
    width: 100%;
    height: auto;
  }
  .visor1-label {
    text-align: center;
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 8px;
  }

  .hotspot {
    position: absolute;
    border: 1.5px dashed var(--guide-purple);
    background: rgba(147, 92, 177, 0.12);
    border-radius: 6px;
    cursor: pointer;
    padding: 0;
  }
  .visor1.swapped .hotspot {
    display: none;
  }
  .hotspot:hover {
    background: rgba(147, 92, 177, 0.24);
  }
  .hotspot.pulsing {
    animation: hotspot-pulse 1.1s ease-out;
  }
  @keyframes hotspot-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(147, 92, 177, 0.5);
    }
    70% {
      box-shadow: 0 0 0 14px rgba(147, 92, 177, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(147, 92, 177, 0);
    }
  }
  .pulse-badge {
    position: absolute;
    top: -14px;
    right: -10px;
    background: var(--guide-purple);
    color: white;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    font-weight: 700;
    padding: 4px 8px;
    border-radius: 999px;
    animation: badge-float 1.6s ease-out forwards;
    pointer-events: none;
  }
  @keyframes badge-float {
    0% {
      opacity: 0;
      transform: translateY(4px) scale(0.8);
    }
    15% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(-10px) scale(0.95);
    }
  }

  .restore-page {
    position: absolute;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 6px 14px;
    border-radius: 999px;
    border: none;
    background: var(--guide-purple);
    color: white;
    cursor: pointer;
    box-shadow: 0 6px 16px -6px rgba(0, 0, 0, 0.5);
  }

  .panel {
    position: relative;
    background: var(--paper-raised);
    border: 1.5px dashed var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 16px;
    max-width: 240px;
  }
  .panel-top {
    position: static !important;
    margin-bottom: 0;
  }
  .left-col .panel,
  .right-col .panel {
    position: absolute;
    left: 0;
    right: 0;
  }
  .panel::after {
    content: "→";
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: var(--guide-purple);
    font-size: 18px;
    font-weight: 700;
  }
  .left-col .panel::after {
    right: -20px;
  }
  .right-col .panel::after {
    content: "←";
    left: -20px;
  }
  .top-row .panel::after {
    content: "↓";
    left: 50%;
    top: auto;
    bottom: -20px;
    transform: translateX(-50%);
  }

  .panel-direction {
    margin: 0 0 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--guide-purple);
  }
  .panel-content {
    margin: 0;
    font-size: 13.5px;
    color: var(--ink-soft);
    display: none;
  }
  .panel.active {
    border-style: solid;
    border-color: var(--guide-purple);
    background: var(--guide-purple-soft);
  }
  .panel.active .panel-content {
    display: block;
    color: var(--ink);
  }

  .reset-all {
    display: block;
    margin: 32px auto 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
  }
</style>
