---
import type { ContentBlock, Moment, Session } from "../types";
import { ANNOTATION_ICON, ANNOTATION_LABEL, MOMENT_LABEL, paginaSrc } from "../types";
import FlowDiagram from "./FlowDiagram.astro";
import GuideHeaderBar from "./GuideHeaderBar.astro";
import MomentBanner from "./MomentBanner.astro";
import DurationBar from "./DurationBar.astro";

interface Props {
  session: Session;
}

const { session } = Astro.props;
const base = import.meta.env.BASE_URL;

type RenderItem = { type: "heading"; moment: Moment } | { type: "block"; block: ContentBlock };

const renderItems: RenderItem[] = [];
let lastMoment: Moment | null = null;
for (const block of session.blocks) {
  if (block.moment !== lastMoment) {
    renderItems.push({ type: "heading", moment: block.moment });
    lastMoment = block.moment;
  }
  renderItems.push({ type: "block", block });
}

const momentBannerLines: Record<Moment, { text: string; tone: "purple" | "pink" }[]> = {
  inicio: [{ text: MOMENT_LABEL.inicio, tone: "pink" }],
  manos: [
    { text: MOMENT_LABEL.manos, tone: "purple" },
    { text: session.manosModalidad, tone: "pink" },
  ],
  cierre: [{ text: MOMENT_LABEL.cierre, tone: "pink" }],
};

const annotationByAnchor = new Map(session.annotations.map((a) => [a.anchor, a]));
const leftAnnotations = session.annotations.filter((_, i) => i % 2 === 0);
const rightAnnotations = session.annotations.filter((_, i) => i % 2 === 1);

const sessionCoverSrc = paginaSrc(base, session.guiaSlug, session.portadaPdfPage);
---

<section class="session" id="session-root" data-layer="docente">
  <header class="session-header">
    <GuideHeaderBar grado={session.grado} guia={session.guiaTitulo} sesion={session.titulo} rol="Docentes" />

    <div class="hero">
      <button
        type="button"
        class="hero-cover"
        data-open-page
        data-page-src={sessionCoverSrc}
        data-page-alt={`Portada de ${session.titulo} en la guía original`}
        data-page-caption={`${session.guiaTitulo} — ${session.titulo}`}
      >
        <img src={sessionCoverSrc} alt={`Portada de ${session.titulo} en la guía original`} loading="eager" />
        <span>📄 ver página original</span>
      </button>

      <div class="hero-info">
        <h1>{session.titulo}</h1>

        <div class="header-grid">
          <div class="card">
            <p class="card-tag">Aprendizajes esperados</p>
            <ul class="plain-list">
              {session.aprendizajesEsperados.map((a) => <li>{a}</li>)}
            </ul>
          </div>
          <div class="card">
            <p class="card-tag">Material para la sesión</p>
            <ul class="plain-list">
              {session.materiales.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        </div>

        <DurationBar duracion={session.duracion} />
      </div>
    </div>

    <button type="button" id="layer-toggle" class="layer-toggle" aria-pressed="false">
      👁️ Vista docente — tocar para ver como estudiante
    </button>
  </header>

  <div class="session-grid">
    <div class="margin-col left">
      {leftAnnotations.map((a) => (
        <div class="annotation" data-kind={a.kind} data-anchor={a.anchor} id={`annotation-${a.id}`}>
          <p class="annotation-kind">{ANNOTATION_ICON[a.kind]} {ANNOTATION_LABEL[a.kind]}</p>
          <h4>{a.title}</h4>
          <p>{a.body}</p>
        </div>
      ))}
    </div>

    <div class="center-col" id="center-col">
      {renderItems.map((item) => {
        if (item.type === "heading") {
          return <MomentBanner id={`moment-${item.moment}`} lines={momentBannerLines[item.moment]} />;
        }

        const block = item.block;
        const annotation = annotationByAnchor.get(block.id);
        const pageSrc = paginaSrc(base, session.guiaSlug, block.pdfPage);

        return (
          <div class="block-wrap">
            {block.kind === "paragraph" && (
              <p class="block" id={block.id}>
                {block.text}
              </p>
            )}
            {block.kind === "callout" && (
              <blockquote class="block callout" id={block.id}>
                {block.text}
              </blockquote>
            )}
            {block.kind === "algorithm" && (
              <ul class="block algorithm" id={block.id}>
                {block.steps.map((s) => <li>{s}</li>)}
              </ul>
            )}
            {block.kind === "glossary" && (
              <dl class="block glossary" id={block.id}>
                {block.terms.map((t) => (
                  <>
                    <dt>{t.term}</dt>
                    <dd>{t.definition}</dd>
                  </>
                ))}
              </dl>
            )}
            {block.kind === "checklist" && (
              <div class="block checklist" id={block.id}>
                {block.items.map((it, i) => (
                  <fieldset>
                    <legend>{it}</legend>
                    {["Sí", "Parcialmente", "Aún no"].map((opt) => (
                      <label>
                        <input type="radio" name={`chk-${session.numero}-${i}`} value={opt} /> {opt}
                      </label>
                    ))}
                  </fieldset>
                ))}
              </div>
            )}
            {block.kind === "flowchart" && (
              <div id={block.id}>
                <FlowDiagram id={`fd-${block.id}`} title={block.title} steps={block.steps} iterations={block.iterations} />
              </div>
            )}

            <div class="block-footer">
              <button
                type="button"
                class="page-tag"
                data-open-page
                data-page-src={pageSrc}
                data-page-alt={`Página original — ${session.titulo}`}
                data-page-caption={`${session.titulo} — página física ${block.pdfPage}`}
              >
                📄 ver página
              </button>

              {annotation && (
                <button
                  type="button"
                  class="chip"
                  data-title={annotation.title}
                  data-body={annotation.body}
                  data-kind-label={`${ANNOTATION_ICON[annotation.kind]} ${ANNOTATION_LABEL[annotation.kind]}`}
                >
                  {ANNOTATION_ICON[annotation.kind]} {ANNOTATION_LABEL[annotation.kind]}
                </button>
              )}
            </div>
          </div>
        );
      })}
    </div>

    <div class="margin-col right">
      {rightAnnotations.map((a) => (
        <div class="annotation" data-kind={a.kind} data-anchor={a.anchor} id={`annotation-${a.id}`}>
          <p class="annotation-kind">{ANNOTATION_ICON[a.kind]} {ANNOTATION_LABEL[a.kind]}</p>
          <h4>{a.title}</h4>
          <p>{a.body}</p>
        </div>
      ))}
    </div>
  </div>

  <dialog id="annotation-dialog" class="annotation-dialog">
    <form method="dialog">
      <p class="annotation-dialog-kind"></p>
      <h3 class="annotation-dialog-title"></h3>
      <p class="annotation-dialog-body"></p>
      <button type="submit">Cerrar</button>
    </form>
  </dialog>
</section>

<script>
  const root = document.getElementById("session-root")!;
  const centerCol = document.getElementById("center-col")!;
  const toggle = document.getElementById("layer-toggle") as HTMLButtonElement;
  const dialog = document.getElementById("annotation-dialog") as HTMLDialogElement;
  const roleTag = root.querySelector(".guide-header-bar .seg-pink");

  function alignAnnotations() {
    const containerRect = centerCol.getBoundingClientRect();
    document.querySelectorAll<HTMLElement>(".annotation[data-anchor]").forEach((ann) => {
      const anchorEl = document.getElementById(ann.dataset.anchor || "");
      if (!anchorEl) return;
      const anchorRect = anchorEl.getBoundingClientRect();
      ann.style.top = `${anchorRect.top - containerRect.top}px`;
    });
  }

  let resizeTimer: ReturnType<typeof setTimeout>;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(alignAnnotations, 100);
  });
  window.addEventListener("load", alignAnnotations);
  document.fonts?.ready.then(alignAnnotations).catch(() => {});
  alignAnnotations();

  toggle.addEventListener("click", () => {
    const isDocente = root.getAttribute("data-layer") === "docente";
    root.setAttribute("data-layer", isDocente ? "estudiante" : "docente");
    toggle.setAttribute("aria-pressed", String(isDocente));
    toggle.textContent = isDocente
      ? "🎓 Vista estudiante — tocar para ver como docente"
      : "👁️ Vista docente — tocar para ver como estudiante";
    if (roleTag) roleTag.textContent = isDocente ? "Estudiantes" : "Docentes";
  });

  document.querySelectorAll<HTMLElement>(".chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      dialog.querySelector(".annotation-dialog-kind")!.textContent = chip.dataset.kindLabel || "";
      dialog.querySelector(".annotation-dialog-title")!.textContent = chip.dataset.title || "";
      dialog.querySelector(".annotation-dialog-body")!.textContent = chip.dataset.body || "";
      dialog.showModal();
    });
  });
</script>

<style>
  .session-header {
    margin-bottom: 12px;
  }
  .hero {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 24px;
    margin: 18px 0;
  }
  @media (max-width: 640px) {
    .hero {
      grid-template-columns: 1fr;
    }
  }
  .hero-cover {
    all: unset;
    cursor: pointer;
    position: relative;
    display: block;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: 0 10px 24px -16px rgba(0, 0, 0, 0.4);
  }
  .hero-cover img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero-cover span {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(20, 15, 25, 0.72);
    color: white;
    font-size: 10.5px;
    font-family: "JetBrains Mono", monospace;
    padding: 5px 8px;
    text-align: center;
  }
  .header-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 16px;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 14px 16px 10px;
    background: var(--guide-purple-soft);
  }
  .card-tag {
    display: inline-block;
    background: var(--guide-pink);
    color: white;
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 999px;
    margin: 0 0 10px;
  }
  .plain-list {
    margin: 0;
    padding-left: 20px;
    font-size: 14.5px;
  }
  .layer-toggle {
    font-family: "JetBrains Mono", monospace;
    font-size: 13px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--teacher);
    background: var(--teacher-soft);
    color: var(--ink);
    cursor: pointer;
  }

  .session-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 900px) {
    .session-grid {
      grid-template-columns: 220px minmax(0, 640px) 220px;
      column-gap: 26px;
    }
  }
  .margin-col {
    position: relative;
    display: none;
  }
  @media (min-width: 900px) {
    .margin-col {
      display: block;
    }
    [data-layer="estudiante"] .margin-col {
      display: none;
    }
  }
  .center-col {
    position: relative;
    min-width: 0;
  }

  .block {
    font-size: 16px;
  }
  .callout {
    background: var(--guide-pink-soft);
    border-left: 3px solid var(--guide-pink);
    border-radius: 0 10px 10px 0;
    margin: 0;
    padding: 14px 18px;
    font-style: italic;
  }
  .algorithm {
    padding-left: 20px;
  }
  .algorithm li {
    margin-bottom: 6px;
  }
  .glossary dt {
    font-family: "JetBrains Mono", monospace;
    font-weight: 600;
    margin-top: 10px;
    color: var(--guide-purple);
  }
  .glossary dd {
    margin-left: 0;
    color: var(--ink-soft);
  }
  .checklist fieldset {
    border: none;
    border-top: 1px solid var(--line);
    padding: 10px 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
  }
  .checklist legend {
    width: 100%;
    font-weight: 600;
    padding: 0;
    margin-bottom: 4px;
  }
  .checklist label {
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .block-wrap {
    margin-bottom: 18px;
  }
  .block-footer {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .page-tag,
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: "JetBrains Mono", monospace;
    font-size: 11.5px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 12px;
    background: var(--paper-raised);
    cursor: pointer;
    color: var(--ink-soft);
  }
  .page-tag:hover {
    border-color: var(--guide-purple);
    color: var(--guide-purple);
  }
  @media (min-width: 900px) {
    .chip {
      display: none;
    }
    [data-layer="estudiante"] .chip {
      display: none;
    }
  }
  [data-layer="estudiante"] .chip {
    display: none;
  }

  .annotation {
    position: absolute;
    left: 0;
    right: 0;
    background: var(--paper-raised);
    border-radius: 0 10px 10px 0;
    padding: 10px 14px;
    font-size: 13px;
    box-shadow: 0 4px 14px -10px rgba(0, 0, 0, 0.3);
  }
  .annotation h4 {
    margin: 2px 0 4px;
    font-size: 14.5px;
  }
  .annotation p {
    margin: 0;
  }
  .annotation-kind {
    font-family: "JetBrains Mono", monospace;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
  }
  .annotation[data-kind="comentario"] {
    border-left: 3px solid var(--pen);
  }
  .annotation[data-kind="diferenciacion"] {
    border-left: 3px solid var(--highlight);
  }
  .annotation[data-kind="diagrama"] {
    border-left: 3px solid var(--teacher);
  }
  .annotation[data-kind="recurso"] {
    border-left: 3px solid var(--ink-soft);
  }

  .annotation-dialog {
    border: none;
    border-radius: 12px;
    padding: 0;
    max-width: 420px;
  }
  .annotation-dialog form {
    padding: 20px 22px;
  }
  .annotation-dialog-kind {
    font-family: "JetBrains Mono", monospace;
    font-size: 11px;
    text-transform: uppercase;
    color: var(--teacher);
    margin: 0 0 6px;
  }
  .annotation-dialog-title {
    margin: 0 0 10px;
    font-size: 18px;
  }
  .annotation-dialog button {
    margin-top: 14px;
    font-family: inherit;
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--paper);
    cursor: pointer;
  }
</style>
