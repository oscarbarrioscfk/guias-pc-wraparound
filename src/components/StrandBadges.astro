---
import { STRAND_LABEL, strandIconSrc, type Strand } from "../types";

interface Props {
  strands: Strand[];
}

const { strands } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<ul class="strand-badges">
  {strands.map((s) => (
    <li>
      <img src={strandIconSrc(base, s)} alt="" width="40" height="40" loading="lazy" />
      <span>{STRAND_LABEL[s]}</span>
    </li>
  ))}
</ul>

<style>
  .strand-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .strand-badges li {
    display: flex;
    align-items: center;
    gap: 8px;
    max-width: 190px;
  }
  .strand-badges img {
    flex: none;
  }
  .strand-badges span {
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.25;
  }
</style>
